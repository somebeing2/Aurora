  "scope": {
    "in_scope_features": [
      "Account Summary",
      "Savings/Current/OD Account Management",
      "UPI (Send/Receive/Collect)",
      "UPI Autopay (e-Mandates)",
      "UPI Lite / Small Value Payments (if applicable)",
      "UPI QR Scan & Pay (Static/Dynamic)",
      "UPI Intent / Deep Link Payments",
      "Fund Transfer (IMPS, NEFT, RTGS)",
      "Beneficiary Management (Add/Verify/Limit Controls)",
      "Bill Payments via BBPS (Electricity, Gas, DTH, Broadband, Water)",
      "Recharges (Prepaid Mobile/DTH/Fastag)",
      "FASTag Services (Recharge/Status/Txn History)",
      "Credit Card Payments",
      "Loan Management (View/Repay/Foreclosure Requests)",
      "Fixed Deposit / RD Booking",
      "Statement Download (PDF) & Email",
      "Cheque Services (Stop Cheque, Cheque Book Request)",
      "Card Management (Debit/Credit Card Controls, Limits, International Usage)",
      "Card Tokenization Support (where applicable)",
      "eKYC / Video KYC Journey (if onboarding in scope)",
      "DigiLocker Document Fetch (KYC/Address Proof support)",
      "Aadhaar/OTP based flows (where legally applicable)",
      "Profile & Nominee Management",
      "Secure Messaging / Service Requests",
      "In-App Notifications & Alerts",
      "Transaction Alerts (SMS/Email/Push)",
      "Customer Support Chatbot",
      "Biometric Login",
      "Device Binding / Trusted Device Management",
      "Root/Jailbreak Detection & App Shielding",
      "AI Fraud Monitoring Alerts",
      "Dispute / Chargeback Initiation (where applicable)",
      "Grievance Redressal & Ticketing",
      "UPI/IMPS/NEFT Transaction Limits & Cooling Period Controls"
    ],
    "out_of_scope": [
      "Core Banking Replacement",
      "Third-party Super App Integration (Phase 1)"
    ]
  },

